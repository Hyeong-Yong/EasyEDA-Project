.options reltol=1e-5 abstol=1e-12 vntol=1e-7 itl1=500 itl4=1000 method=trap
.temp 27
.include "C:/Dev/EasyEDA/EasyEDA-Project/STM32H747 board/output/simulation-20261018/runtime/warm-start-full.inc"

V5 v5 0 DC 5
V3 v3 0 DC 3.3
VN vn3 0 DC -3.01244
